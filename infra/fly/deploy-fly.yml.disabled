name: deploy-fly
on:
  push:
    branches: [deploy]
  workflow_dispatch:
jobs:
  deploy:
    runs-on: ubuntu-latest
    environment: production   # requires owner approval
    steps:
      - uses: actions/checkout@v4
      - uses: superfly/flyctl-actions/setup-flyctl@master
      - run: flyctl deploy --remote-only --image-label ${{ github.sha }}
        env:
          FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
      - run: flyctl status
        env:
          FLY_API_TOKEN: ${{ secrets.FLY_API_TOKEN }}
